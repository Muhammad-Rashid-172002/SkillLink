rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /verification_requests/{workerId} {
      allow create, read, update: if isOwner(workerId)
        && request.resource.data.workerId == request.auth.uid;

      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // Example only. Protect approval fields in your actual production rules.
      allow update: if isOwner(uid)
        && request.resource.data.identityVerificationStatus
            == resource.data.identityVerificationStatus
        && request.resource.data.verificationLevel
            == resource.data.verificationLevel
        && request.resource.data.canAcceptJobs
            == resource.data.canAcceptJobs;
    }
  }
}
