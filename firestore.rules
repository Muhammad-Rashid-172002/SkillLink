rules_version = '2';

// SkillNova Firestore security rules.
//
// Principles:
//  * Roles are decided on the server (Cloud Function `initializeAccount`)
//    and stored in users/{uid}.role + the `role` custom claim. Clients can
//    never create a profile or change a role.
//  * A person can never grant themselves verification, job eligibility,
//    ratings, an account status or a verified phone/email from the client.
//  * Customer profiles are private. Other people read `public_profiles`,
//    which a Cloud Function maintains without email/phone/location.
//  * Job status moves only along allowed transitions, by the right party.
//  * Live location is visible only to the job's customer and assigned worker.
//  * Admins = documents in /admins/{uid} with isActive == true.
//  * The platform is free: no client can create payments or spend credits.
//
// Cloud Functions use the Admin SDK and are not affected by these rules.
// Test with: cd firestore-tests && ./run.sh
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isOwner(userId) { return signedIn() && uid() == userId; }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(uid()))
        && get(/databases/$(database)/documents/admins/$(uid())).data.get('isActive', false) == true;
    }

    function appRoles() { return ['customer', 'worker']; }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }
    // The custom claim is set by the server; the stored role is the fallback
    // for tokens issued before the claim existed. Both are server-controlled.
    function myRole() {
      return request.auth.token.get('role', '') in appRoles()
        ? request.auth.token.role
        : myProfile().get('role', '');
    }
    function isCustomer() { return signedIn() && myRole() == 'customer'; }
    function isWorker() { return signedIn() && myRole() == 'worker'; }
    function isActiveAccount() {
      return !(myProfile().get('accountStatus', 'active') in ['suspended', 'blocked', 'deleted']);
    }
    function workerCanAcceptJobs() {
      return isWorker()
        && isActiveAccount()
        && myProfile().get('identityVerificationStatus', '') == 'approved'
        && myProfile().get('canAcceptJobs', false) == true;
    }

    // Fields only an admin or a Cloud Function may set on a profile.
    function protectedProfileKeys() {
      return ['role', 'uid', 'accountStatus', 'accountStatusReason',
        'credits', 'leadCredits', 'rating', 'averageRating', 'avgRating',
        'totalReviews', 'completedJobs', 'completedJobCount', 'jobsCompleted',
        'statsUpdatedAt', 'isVerified', 'verified', 'workerVerified',
        'verificationStatus', 'verifiedAt', 'verificationReason',
        'isBlocked', 'blocked', 'isDisabled', 'backgroundVerificationStatus',
        'roleAssignedBy', 'roleRecoveredFrom', 'roleRecoveredAt',
        'userType', 'user_type', 'accountType', 'account_type', 'userRole',
        'user_role', 'type'];
    }

    function newData() { return request.resource.data; }
    function oldData() { return resource.data; }
    function unchanged(field) {
      return newData().get(field, null) == oldData().get(field, null);
    }
    function changedKeys() { return newData().diff(oldData()).affectedKeys(); }

    function validLat(v) { return v is number && v >= -90 && v <= 90; }
    function validLng(v) { return v is number && v >= -180 && v <= 180; }

    // ------------------------------------------------------------------ users
    match /users/{userId} {
      // Worker profiles are a public directory customers browse. Customer
      // profiles are private: only the owner and admins read them.
      allow read: if isOwner(userId)
        || isAdmin()
        || (signedIn() && resource.data.get('role', '') == 'worker');

      // Profiles are created only by the initializeAccount Cloud Function.
      allow create: if false;

      allow update: if isAdmin()
        || (isOwner(userId) && ownerUpdateIsSafe());

      allow delete: if isAdmin();

      function verificationUpdateIsSafe() {
        // Workers may only *submit* verification (-> pending).
        return (unchanged('identityVerificationStatus')
                && unchanged('verificationLevel'))
          || (oldData().get('role', '') == 'worker'
              && oldData().get('identityVerificationStatus', 'not_submitted')
                   in ['not_submitted', 'rejected', 'more_information_required', 'pending']
              && newData().identityVerificationStatus == 'pending'
              && newData().get('verificationLevel', 'unverified') == 'unverified');
      }

      function availabilityUpdateIsSafe() {
        // Only approved workers can switch job availability on.
        return unchanged('canAcceptJobs')
          || newData().canAcceptJobs == false
          || (oldData().get('role', '') == 'worker'
              && oldData().get('identityVerificationStatus', '') == 'approved'
              && newData().canAcceptJobs == true);
      }

      function emailFlagIsSafe() {
        return unchanged('emailVerified')
          || newData().emailVerified == false
          || request.auth.token.get('email_verified', false) == true;
      }

      function phoneIsSafe() {
        // A phone is "verified" only when Firebase Auth holds that number
        // (linked after a real SMS code check).
        return (unchanged('phoneVerified') && unchanged('phoneNumber'))
          || (newData().get('phoneVerified', false) == false
              && newData().get('phoneNumber', null) == null)
          || (newData().get('phoneVerified', false) == true
              && request.auth.token.get('phone_number', '') != ''
              && newData().get('phoneNumber', '') == request.auth.token.phone_number);
      }

      function ownerUpdateIsSafe() {
        return verificationUpdateIsSafe()
          && availabilityUpdateIsSafe()
          && emailFlagIsSafe()
          && phoneIsSafe()
          && !changedKeys().hasAny(protectedProfileKeys());
      }
    }

    // ----------------------------------------------- public (safe) profiles
    // Maintained by the syncAccountState Cloud Function: name, photo, city,
    // role, worker skills and ratings. Never email, phone or coordinates.
    match /public_profiles/{userId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // --------------------------------------------------------------- requests
    match /requests/{requestId} {
      function isRequestCustomer() {
        return signedIn() && resource.data.get('customerId', '') == uid();
      }
      function isAssignedWorker() {
        return signedIn() && resource.data.get('workerId', '') == uid();
      }
      // Open leads are visible to workers (list queries filter on status).
      function isOpenLead() {
        return resource.data.get('status', '') == 'searching';
      }

      allow read: if isAdmin()
        || isRequestCustomer()
        || isAssignedWorker()
        || (isWorker() && isOpenLead());

      // What the customer entered; only the customer's create sets it.
      function customerContentKeys() {
        return ['customerId', 'title', 'description', 'category', 'location',
          'budget', 'urgency', 'isDirectRequest', 'requestType', 'imageUrls',
          'imageCount', 'latitude', 'longitude', 'createdAt'];
      }
      function cancellable() {
        return resource.data.get('status', '')
          in ['searching', 'pending', 'requested', 'waiting_worker', 'accepted'];
      }
      function noWorkerOrMe() {
        return resource.data.get('workerId', null) in [null, '', uid()];
      }
      function oldStatus() {
        // Legacy spellings map onto the canonical lifecycle.
        let s = resource.data.get('status', '');
        return s == 'started' ? 'in_progress'
          : (s == 'ontheway' ? 'on_the_way' : s);
      }
      function newStatus() { return newData().get('status', ''); }

      // Worker lifecycle: accepted -> on_the_way -> in_progress -> completed.
      // A worker may hand back a job before starting it.
      function validWorkerTransition() {
        return (oldStatus() == 'accepted' && newStatus() in ['on_the_way', 'cancelled'])
          || (oldStatus() == 'on_the_way' && newStatus() in ['in_progress', 'cancelled'])
          || (oldStatus() == 'in_progress' && newStatus() == 'completed');
      }
      function workerProgressKeys() {
        return ['status', 'updatedAt', 'onTheWayAt', 'arrivedAt', 'startedAt',
          'completedAt', 'reviewPending', 'reviewed', 'cancelledAt',
          'cancelledBy', 'cancellationReason', 'chatId'];
      }

      allow create: if isCustomer()
        && isActiveAccount()
        && newData().customerId == uid()
        && newData().status == 'searching'
        && newData().get('reviewed', false) == false
        && newData().title is string && newData().title.size() > 0 && newData().title.size() <= 120
        && newData().get('description', '') is string && newData().get('description', '').size() <= 2000
        && (newData().get('latitude', null) == null || validLat(newData().latitude))
        && (newData().get('longitude', null) == null || validLng(newData().longitude))
        // A direct request names one worker; a public request names none.
        && (newData().get('workerId', null) == null
            || (newData().get('isDirectRequest', false) == true
                && newData().workerId is string))
        && !newData().keys().hasAny(['acceptedAt', 'completedAt', 'reviewedAt',
             'price', 'fee', 'paymentStatus', 'amountPaid']);

      allow update: if isAdmin()
        // Customers: cancel before work starts, link a chat, record that they
        // reviewed a completed job, and raise SOS. Never assign a worker or
        // move a job forward (that would allow fake completions and reviews).
        || (isRequestCustomer()
            && changedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy',
                 'cancellationReason', 'chatId',
                 'reviewed', 'reviewPending', 'reviewedAt',
                 'hasActiveEmergency', 'activeEmergencyAlertId',
                 'lastEmergencyAt', 'updatedAt'])
            && (unchanged('status')
                || (newStatus() == 'cancelled' && cancellable()))
            && (unchanged('reviewed')
                || (newData().reviewed == true
                    && resource.data.get('status', '') == 'completed'
                    && existsAfter(/databases/$(database)/documents/reviews/$(requestId)))))
        // Workers: accept an open lead (or one sent to them) — free of charge,
        // but only when verified and available.
        || (workerCanAcceptJobs()
            && isOpenLead()
            && noWorkerOrMe()
            && newStatus() == 'accepted'
            && newData().get('workerId', '') == uid()
            && changedKeys().hasOnly(['status', 'workerId', 'acceptedAt', 'updatedAt']))
        // Workers: progress their own job along the lifecycle, or link a chat
        // or raise SOS without changing the status.
        || (isWorker()
            && isAssignedWorker()
            && newData().get('workerId', '') == uid()
            && !changedKeys().hasAny(customerContentKeys())
            && !changedKeys().hasAny(['reviewedAt', 'workerId', 'customerId'])
            && newData().get('reviewed', false) == false
            && ((changedKeys().hasOnly(workerProgressKeys()) && validWorkerTransition())
                || (unchanged('status')
                    && changedKeys().hasOnly(['chatId', 'hasActiveEmergency',
                         'activeEmergencyAlertId', 'lastEmergencyAt', 'updatedAt']))));

      allow delete: if isAdmin();

      // Customer contact details for the assigned worker only (written by the
      // shareCustomerContact Cloud Function when a worker accepts).
      match /private/{docId} {
        function parentRequest() {
          return get(/databases/$(database)/documents/requests/$(requestId)).data;
        }
        allow read: if isAdmin()
          || (signedIn() && (parentRequest().get('customerId', '') == uid()
              || parentRequest().get('workerId', '') == uid()));
        allow write: if false;
      }
    }

    // ------------------------------------------------------ live tracking
    // live_tracking/{requestId}: the assigned worker writes their own GPS
    // position only while the job is active; route/ETA is written by the
    // computeJobRoute Cloud Function (server-side Routes API key).
    match /live_tracking/{requestId} {
      function job() {
        return get(/databases/$(database)/documents/requests/$(requestId)).data;
      }
      function activeStatus(s) {
        return s in ['accepted', 'on_the_way', 'ontheway', 'in_progress', 'started'];
      }
      function validWorkerLocation(location) {
        return location is map
          && location.keys().hasOnly(['latitude', 'longitude', 'heading',
               'speed', 'accuracy', 'updatedAt'])
          && validLat(location.latitude)
          && validLng(location.longitude)
          && (location.get('accuracy', 0) == null || location.get('accuracy', 0) is number)
          && location.get('updatedAt', request.time) == request.time;
      }

      allow read: if isAdmin()
        || (signedIn() && (resource.data.get('customerId', '') == uid()
            || resource.data.get('workerId', '') == uid()));

      allow create, update: if isWorker()
        && job().get('workerId', '') == uid()
        && activeStatus(job().get('status', ''))
        && newData().get('workerId', '') == uid()
        && newData().get('customerId', '') == job().get('customerId', '')
        && newData().get('requestId', '') == requestId
        && newData().keys().hasOnly(['requestId', 'customerId', 'workerId',
             'workerLocation', 'workerLocationUpdatedAt', 'isActive',
             'status', 'updatedAt', 'route', 'startedAt', 'endedAt',
             'customerLocation', 'customerLocationUpdatedAt', 'expiredAt'])
        && validWorkerLocation(newData().workerLocation)
        && newData().get('updatedAt', null) == request.time
        && newData().get('isActive', true) == true
        && (request.method == 'create'
            || changedKeys().hasOnly(['workerLocation', 'workerLocationUpdatedAt',
                 'isActive', 'updatedAt']));

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------ chats
    match /chats/{chatId} {
      function isParticipant(data) {
        return signedIn()
          && (data.get('customerId', '') == uid() || data.get('workerId', '') == uid());
      }

      allow read: if isAdmin() || isParticipant(resource.data);
      allow create: if isParticipant(newData())
        && newData().customerId is string && newData().workerId is string
        && newData().customerId != newData().workerId;
      allow update: if isAdmin()
        || (isParticipant(resource.data)
            && unchanged('customerId') && unchanged('workerId'));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        allow read, update: if isAdmin() || isParticipant(parentChat());
        allow create: if isParticipant(parentChat())
          && newData().get('senderId', uid()) == uid();
        allow delete: if isAdmin();
      }
    }

    // ---------------------------------------------------------- notifications
    match /notifications/{notificationId} {
      allow read, delete: if isAdmin()
        || (signedIn() && resource.data.get('userId', '') == uid());
      // Written by Cloud Functions (job alerts, status updates) and the
      // admin console. Clients never fan out notifications to other users.
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (signedIn() && resource.data.get('userId', '') == uid()
            && changedKeys().hasOnly(['isRead', 'readAt', 'updatedAt']));
    }

    // ---------------------------------------------------------------- reviews
    // One review per completed request (the doc id is the request id), by
    // that request's customer, for the worker who did the job. Reviews are
    // immutable for clients; worker aggregates are computed server-side.
    match /reviews/{reviewId} {
      function reviewedRequest() {
        return get(/databases/$(database)/documents/requests/$(reviewId)).data;
      }
      allow read: if signedIn();
      allow create: if isCustomer()
        && newData().customerId == uid()
        && newData().requestId == reviewId
        && newData().rating is number
        && newData().rating == math.floor(newData().rating)
        && newData().rating >= 1 && newData().rating <= 5
        && newData().get('review', '') is string
        && newData().get('review', '').size() <= 2000
        && newData().get('customerName', '') is string
        && newData().get('customerName', '').size() <= 80
        && (newData().get('customerPhotoUrl', null) == null
            || (newData().customerPhotoUrl is string
                && newData().customerPhotoUrl.size() <= 1000))
        && newData().keys().hasOnly(['workerId', 'customerId', 'requestId',
             'rating', 'review', 'customerName', 'customerPhotoUrl',
             'serviceTitle', 'createdAt'])
        && exists(/databases/$(database)/documents/requests/$(reviewId))
        && reviewedRequest().get('customerId', '') == uid()
        && reviewedRequest().get('status', '') == 'completed'
        && reviewedRequest().get('workerId', '') == newData().workerId;
      allow update, delete: if isAdmin();
    }

    // ------------------------------------------------- verification requests
    match /verification_requests/{workerId} {
      allow read: if isAdmin() || isOwner(workerId);
      allow create, update: if isAdmin()
        || (isOwner(workerId)
            && isWorker()
            && newData().workerId == uid()
            && newData().get('identityStatus', 'pending') == 'pending'
            && newData().get('status', 'pending') == 'pending');
      allow delete: if isAdmin();
    }

    // --------------------------------- legacy payments & credits (read-only)
    // SkillNova is free. Historical records stay readable by their owner and
    // admins, but nobody can create new payment requests or spend credits.
    match /payment_requests/{paymentId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.get('workerId', '') == uid());
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.get('workerId', '') == uid());
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------- safety / SOS
    match /emergency_alerts/{alertId} {
      function involved(data) {
        return signedIn()
          && (data.get('raisedBy', '') == uid()
              || data.get('customerId', '') == uid()
              || data.get('workerId', '') == uid());
      }
      allow read: if isAdmin() || involved(resource.data);
      allow create: if signedIn() && newData().raisedBy == uid();
      allow update: if isAdmin()
        || (involved(resource.data) && unchanged('raisedBy')
            && unchanged('customerId') && unchanged('workerId'));
      allow delete: if isAdmin();
    }

    match /admin_notifications/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if signedIn()
        && newData().get('raisedBy', uid()) == uid();
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && newData().get('reporterId', uid()) == uid();
      allow read, update, delete: if isAdmin();
    }

    // Support requests from the Help screens.
    match /support_requests/{ticketId} {
      allow create: if signedIn()
        && newData().userId == uid()
        && newData().message is string
        && newData().message.size() > 0 && newData().message.size() <= 4000
        && newData().get('status', 'open') == 'open';
      allow read: if isAdmin()
        || (signedIn() && resource.data.get('userId', '') == uid());
      allow update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------ admin
    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow write: if false; // managed via Firebase console / Admin SDK
    }

    match /admin_settings/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /admin_audit_logs/{doc} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
